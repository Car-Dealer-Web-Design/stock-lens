{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stock Lens example structure",
  "description": "Structural guide to the supplied example. Runtime validation enforces supported states, publication gates and cross-field rules.",
  "type": "object",
  "properties": {
    "dealer": {
      "type": "string"
    },
    "updatedOn": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "vehicles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stock_id": {
            "type": "string"
          },
          "make": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "year": {
            "type": "number"
          },
          "mileage": {
            "type": "number"
          },
          "mileage_unit": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "viewing_url": {
            "type": "string"
          }
        },
        "required": [
          "stock_id",
          "make",
          "model",
          "year",
          "mileage",
          "mileage_unit",
          "price",
          "status",
          "viewing_url"
        ]
      }
    }
  },
  "required": [
    "dealer",
    "updatedOn",
    "currency",
    "vehicles"
  ]
}
